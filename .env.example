# Base de datos y Servidor Web
DB_TYPE=sqlite
DB_NAME=pbx.db
WEB_PORT=35248
WEB_HOST=127.0.0.1
LOG_LEVEL=info

# Rutas de almacenamiento temporal y cache
MEDIA_PATH=/tmp/pbx_media/
CACHE_PATH=/tmp/pbx_cache/

# Configuración de Inteligencia Artificial (OpenAI / LLM)
AI_TOKEN=sk-proj-demo-open-ai-token-pbx-ai-2024
LLM_URL=https://api.openai.com/v1/chat/completions

# Integración con Telegram Bot API
TELEGRAM_TOKEN=7182938475:AAH_DEMO_PBX_AI_BOT_TOKEN_TELEGRAM_2024

# Integración con WhatsApp Cloud API (Meta)
META_URL=https://graph.facebook.com/v20.0/109283746592810/messages
META_USER=109283746592810
META_AUTH=EAABwzLp12k8BAOzKeyDemoWhatsAppCloudAPI2024ProductionPBX
META_TOKEN=pbx_ai_webhook_verify_token_secure_99

# Integración con Telefonía Asterisk PBX (AGI / ARI)
ASTERISK_ENABLED=false
ASTERISK_AGI=127.0.0.1:4573
ASTERISK_ARI=http://127.0.0.1:8088/ari
ASTERISK_TOKEN=ast_ari_pbx_secret_token_2024

# Model Context Protocol (MCP) Server
MCP_URL=http://127.0.0.1:8000/mcp/sse
MCP_TOKEN=mcp_sec_token_pbx_ai_production_7749

# Web Chat y Notificaciones
CHAT_ENABLED=true
CHAT_AUDIO=true
CHAT_CORS=*
ALERT_NTFY=https://ntfy.sh/pbx_alerts_demo
MAIL_SENDER=pbx-alerts@empresa.com
